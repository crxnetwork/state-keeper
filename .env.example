# Copy to .env — secrets arrive ONLY via the environment; .env is gitignored.

# RPC endpoint for the lane you drive (overrides the chains.json preset).
RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# The key that signs the applyState transaction (advance only). Needs lane gas.
PRIVATE_KEY=

# Your Succinct Prover Network requester key (advance only). Proving spends a fee
# from this account: https://docs.succinct.xyz/
NETWORK_PRIVATE_KEY=
